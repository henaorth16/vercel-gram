{
  "name": "vercel-telegram-bot",
  "version": "1.0.0",
  "description": "Multi-user Telegram bot to track Vercel projects, deployments, build logs, and analytics",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "test": "vitest run"
  },
  "keywords": [
    "telegram",
    "vercel",
    "bot",
    "deployments",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "@prisma/client": "^6.19.3",
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-raw-body": "^6.0.3",
    "grammy": "^1.46.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
