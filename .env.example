# Telegram Bot Configuration
# Obtain your bot token from https://t.me/BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Master AES-256-GCM Encryption Key (64-character hex string = 32 bytes)
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
# Local SQLite default (used when TURSO_DATABASE_URL is not set):
DATABASE_URL="file:./dev.db"

# Turso Distributed SQLite (Production & Vercel deployment)
TURSO_DATABASE_URL="libsql://vercel-gram-henaorth.aws-eu-central-1.turso.io"
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Vercel Webhook Secret (Required for verifying incoming webhooks)
VERCEL_WEBHOOK_SECRET=your_vercel_webhook_secret_here

# Access Control (Optional)
ALLOWED_TELEGRAM_USERS=
