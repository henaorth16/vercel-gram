# Telegram Bot Configuration
# Obtain your bot token from https://t.me/BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Master AES-256-GCM Encryption Key (64-character hex string = 32 bytes)
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (SQLite default)
DATABASE_URL="file:./dev.db"

# Vercel Webhook Secret (Required for verifying incoming webhooks)
# Set this to the secret provided when creating a Webhook in Vercel Settings
VERCEL_WEBHOOK_SECRET=your_vercel_webhook_secret_here

# Access Control (Optional)
# Comma-separated list of Telegram User IDs allowed to use the bot.
# Leave empty to allow any user to connect their own Vercel account.
ALLOWED_TELEGRAM_USERS=
